# Toolchain image for the seeds repo — adapted from denkhaus/fabro's
# .fabro/Dockerfile.toolchain at bootstrap (2026-09-26, ADR-0023).
# Standalone repo, no upstream fork, no generated TS client, no pytest
# workflows: the fabro image's cargo-chef cook arms, pytest layer, and
# staged fabro/fabro-validate binaries are deliberately NOT ported — the
# develop line adds stages back when seeds demand them (loop-asset
# evolution). Base ubuntu:24.04 (not buildpack-deps) per the fabro image's
# CVE rationale. graphviz (workflow-graph validation/rendering) and the
# mold linker anchor stay.
FROM ubuntu:24.04

ARG RUST_NIGHTLY=nightly-2026-04-14

RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends \
        bash git ca-certificates curl xz-utils \
        build-essential pkg-config perl cmake \
        graphviz mold; \
    dot -V; \
    mold --version; \
    rm -rf /var/lib/apt/lists/*

RUN set -eux; \
    curl --proto '=https' --tlsv1.2 -sSf https://sh.rustup.rs | sh -s -- -y --default-toolchain ${RUST_NIGHTLY}; \
    export PATH="/root/.cargo/bin:${PATH}"; \
    rustup toolchain install ${RUST_NIGHTLY} --profile minimal --component clippy,rustfmt; \
    cargo install cargo-nextest --locked

ENV PATH="/root/.cargo/bin:${PATH}"

# mold as the Rust linker for every build resolving cargo config from
# /root/.cargo (run containers included).
RUN set -eux; \
    printf '[target.x86_64-unknown-linux-gnu]\nrustflags = ["-C", "link-arg=-fuse-ld=mold"]\n' \
        > /root/.cargo/config.toml

# Workspace toolset via mise: nushell (loop scripts), just (gate recipes),
# ripgrep. Tool-agnostic layering (ADR-0017 in the fabro repo): the
# engine's clone contract places this repository at /repos/denkhaus/seeds
# with a /workspace/seeds execution symlink — the trust path pins exactly
# that.
ARG MISE_VERSION=v2026.8.10
ENV MISE_DATA_DIR=/mise \
    MISE_TRUSTED_CONFIG_PATHS=/repos/denkhaus/seeds \
    BUN_INSTALL=/mise/bun-global \
    PATH=/mise/shims:/mise/bun-global/bin:${PATH}

RUN set -eux; \
    curl -fsSL "https://github.com/jdx/mise/releases/download/${MISE_VERSION}/mise-${MISE_VERSION}-linux-x64" \
        -o /usr/local/bin/mise; \
    chmod +x /usr/local/bin/mise; \
    mise use -g \
        bun@1.4.0 \
        aqua:nushell/nushell@0.115.0 \
        just@1.58.0 \
        aqua:BurntSushi/ripgrep@15.2.0 \
    && bun --version \
    && nu --version \
    && just --version \
    && rg --version

# Repo agent tooling: AGENTS.md asks agents to run `seeds prime` / `ml
# prime` at session start. Mulch keeps the bootstrap-phase jayminwest CLI
# (ADR-0023; read+write compatible target until the mulch phase),
# installed through the mise bun into BUN_INSTALL. The seeds tracker CLI
# was dropped here at the self-hosting cutover (seeds-3791): the tracker
# is this repo's own Rust binary, built from source below.
RUN mise exec -- bun install -g \
        @os-eco/mulch-cli@0.10.7 \
    && ml --version

# Self-hosting cutover (seeds-3791): build this repo's own `seeds`
# binary and install it onto PATH. Build context is the REPO ROOT (see
# scripts/run-images.nu; the root .dockerignore keeps the context to
# Cargo.toml, Cargo.lock, and crates/). The clone at
# /repos/denkhaus/seeds at run time does not shadow /usr/local/bin, so
# the baked binary stays available; the content-hash gate in
# scripts/run-images.nu covers the copied sources, so any crate change
# rebuilds the image (repin the pushed sha tag after merge, same flow as
# the python3 fix).
COPY Cargo.toml Cargo.lock /src/
COPY crates /src/crates
RUN set -eux; \
    cargo install --path /src/crates/seeds --locked --root /usr/local; \
    seeds --version; \
    rm -rf /src

# python3 (stdlib only, late layer to preserve cache): LOAD-BEARING for
# the loop — the dup-run-check fixture battery's schema-ban check shells
# out to python3 (first seeds cycle 01M2ZW7TT6KK died 3x deterministic
# on 'Command python3 not found', 2026-09-26), and python3 heredocs are
# the documented fs_hide escape hatch in the develop prompts. No
# pip/pytest at bootstrap (no python deps yet).
RUN set -eux; \
    apt-get update; \
    apt-get install -y --no-install-recommends python3; \
    python3 --version; \
    rm -rf /var/lib/apt/lists/*
